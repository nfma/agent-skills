{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfma.dev/agent-skills/evals/run-manifest.schema.json",
  "title": "Frozen Agent Skill evaluation run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "plan_sha256",
    "trials"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "trials": { "type": "array", "items": { "type": "object" } }
  }
}

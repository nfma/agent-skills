{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfma.dev/agent-skills/evals/calibration-report.schema.json",
  "title": "Blind evaluation sensitivity calibration report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_name",
    "calibration_set_sha256",
    "key_sha256",
    "grader_model",
    "grader_context",
    "graded_after_set_frozen",
    "grades"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "skill_name": { "type": "string" },
    "calibration_set_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "key_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "grader_model": { "type": "string", "minLength": 1 },
    "grader_context": { "type": "string", "minLength": 1 },
    "graded_after_set_frozen": { "const": true },
    "grades": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  }
}

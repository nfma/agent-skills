#!/bin/bash

# Load a dedicated fine-grained GitHub PAT from macOS Keychain. The token is
# exposed only to the MCP child process and is never written to configuration.
set -euo pipefail

find_executable() {
  command_name=$1
  configured_path=$2
  if [[ -n "$configured_path" && -x "$configured_path" ]]; then
    printf '%s\n' "$configured_path"
    return 0
  fi
  if command -v "$command_name" >/dev/null 2>&1; then
    command -v "$command_name"
    return 0
  fi
  for candidate_path in "/opt/homebrew/bin/$command_name" "/usr/local/bin/$command_name"; do
    if [[ -x "$candidate_path" ]]; then
      printf '%s\n' "$candidate_path"
      return 0
    fi
  done
  return 1
}

mcp_bin=$(find_executable github-mcp-server "${MCP_BIN:-}") || {
  echo 'github-mcp-keychain: github-mcp-server is unavailable' >&2
  exit 127
}

security_bin=${GITHUB_MCP_SECURITY_BIN:-/usr/bin/security}
if [[ "$security_bin" != /* || ! -x "$security_bin" ]]; then
  echo 'github-mcp-keychain: security command is unavailable' >&2
  exit 127
fi

token="$($security_bin find-generic-password \
  -l GITHUB_MCP_PAT -w 2>/dev/null || true)"
if [[ -z "$token" ]]; then
  echo 'github-mcp-keychain: Keychain item labeled GITHUB_MCP_PAT is missing' >&2
  exit 1
fi

export GITHUB_PERSONAL_ACCESS_TOKEN="$token"
unset token

if [[ $# -eq 0 ]]; then
  set -- stdio
fi

exec "$mcp_bin" "$@"

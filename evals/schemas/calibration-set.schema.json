{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfma.dev/agent-skills/evals/calibration-set.schema.json",
  "title": "External evaluation sensitivity calibration set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_name",
    "suite_canonical_sha256",
    "key_sha256",
    "reviewer",
    "reviewed_at",
    "source_models",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "skill_name": { "type": "string" },
    "suite_canonical_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "key_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reviewer": { "type": "string", "minLength": 1 },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "source_models": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "cases": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  }
}

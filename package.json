{
  "name": "agent-skills",
  "private": true,
  "scripts": {
    "format:check": "prettier --check \".github/**/*.yml\" \".*-baseline.json\" \".skill-audit-release.json\" \"evals/README.md\" \"evals/harnesses.json\" \"evals/registry.json\" \"evals/schemas/*.json\" \"eslint.config.mjs\" \"mcp/bin/*.{js,cjs}\" \"package*.json\" \"scripts/*.mjs\" \"skills/huggingface-tool-builder/references/*.tsx\" \"tests/**/*.js\" \"tsconfig.json\"",
    "lint:js": "eslint mcp/bin scripts tests skills/huggingface-tool-builder/references/baseline_hf_api.tsx --max-warnings 0",
    "lint:python": "node scripts/check-python-quality.mjs",
    "lint:shell": "node scripts/check-shell-quality.mjs",
    "migrate:skill-audit-baseline": "node scripts/migrate-skill-audit-baseline.mjs",
    "test": "npm run test:installer && npm run test:quota-supervisor && npm run test:codex-config && npm run test:sync-skills && npm run test:hf-filter && npm run test:skill-audit-release && npm run test:skill-audit-accepted-findings && npm run test:skill-compatibility-policy && npm run test:git-workflow-policy && npm run test:hexagonal-architecture-policy && npm run test:workflow-security && npm run test:fuzz:node && npm run test:skill-evals && npm run test:python",
    "test:codex-config": "node --test tests/update-codex-mcp-config.test.js",
    "test:hf-filter": "node --test tests/hf-mcp-filter.test.js",
    "test:fuzz": "npm run test:fuzz:node && npm run test:fuzz:python",
    "test:fuzz:node": "node --test tests/fuzz/*.test.js",
    "test:fuzz:python": "PYTHONDONTWRITEBYTECODE=1 uv run --frozen python -m unittest discover -s tests/python -p 'test_fuzz_*.py'",
    "test:installer": "bats tests/install-mcps.bats",
    "test:quota-supervisor": "bats tests/manage-quota-supervisor.bats",
    "test:python": "PYTHONDONTWRITEBYTECODE=1 uv run --frozen python -m unittest discover -s tests/python -p 'test_*.py'",
    "test:skill-audit-release": "./scripts/prepare-vendored-skills.sh && node --test tests/skill-audit-release.test.js",
    "test:skill-audit-accepted-findings": "node --test tests/skill-audit-accepted-findings.test.js",
    "test:skill-compatibility-policy": "node --test tests/skill-compatibility-policy.test.js",
    "test:git-workflow-policy": "node --test tests/git-workflow-policy.test.js",
    "test:hexagonal-architecture-policy": "node --test tests/hexagonal-architecture-policy.test.js",
    "test:skill-evals": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/skill-evals.py validate",
    "test:sync-skills": "bats tests/sync-agent-skills.bats",
    "test:workflow-security": "node --test tests/sonar-workflow.test.js",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "bats": "1.13.0",
    "eslint": "10.8.1",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.67.0",
    "yaml": "2.9.0"
  }
}

{
  "plugins": {
    "install": [
      {
        "id": "aikido@claude-plugins-official",
        "servers": ["aikido"]
      },
      {
        "id": "chrome-devtools-mcp@claude-plugins-official",
        "servers": ["chrome-devtools"]
      },
      {
        "id": "context7@claude-plugins-official",
        "servers": ["context7"]
      },
      {
        "id": "github@claude-plugins-official",
        "servers": ["github"]
      },
      {
        "id": "playwright@claude-plugins-official",
        "servers": ["playwright"]
      },
      {
        "id": "semgrep@claude-plugins-official",
        "servers": ["guardian"]
      }
    ],
    "remove": []
  },
  "mcpServers": {
    "browser-tools": {
      "type": "stdio",
      "localCommand": "npx",
      "args": ["-y", "@agentdeskai/browser-tools-mcp@1.2.0"]
    },
    "excalidraw": {
      "type": "stdio",
      "localCommand": "npx",
      "args": ["-y", "mcp-excalidraw-server@1.1.0"]
    },
    "hf": {
      "type": "http",
      "url": "https://huggingface.co/mcp"
    },
    "serena": {
      "type": "stdio",
      "localCommand": "serena-mcp",
      "args": [
        "start-mcp-server",
        "--context=claude-code",
        "--project-from-cwd",
        "--add-mode=no-memories",
        "--add-mode=rust-only"
      ]
    }
  }
}

      "id": "prohibited-effects",
      "type": "deterministic",
      "dimension": "safety",
      "implementation": "normalized trace and pre/post state hashes enforce the task effect policy"
    },
    {
      "id": "outcome-quality",
      "type": "blinded-model",
      "dimension": "outcome",
      "implementation": "external sealed reference solution graded one rubric dimension at a time"
    }
  ],
